# Key sent to Zen. Leave empty for anonymous traffic: `GET /models` still works,
# but every free model (space-bunny-free included) answers 403 FreeTierError
# without a real key, no matter which client headers are sent.
# Get one at https://opencode.ai/auth
ZEN_API_KEY=

# Server bind address.
ZEN_PROXY_HOST=0.0.0.0
ZEN_PROXY_PORT=8787

# Upstream gateway.
ZEN_PROXY_ZEN_BASE_URL=https://opencode.ai/zen/v1
ZEN_PROXY_REQUEST_TIMEOUT=600
ZEN_PROXY_CONNECT_TIMEOUT=15
ZEN_PROXY_MAX_RETRIES=2

# Seconds between refreshes of the free model list, the routes that serve them, and
# the context windows. 0 fetches once at startup and then leaves the catalog alone.
ZEN_PROXY_CATALOG_TTL=900

# Where the catalog comes from. Zen's /models lists ids and nothing else, so the
# three questions - is this model free, which Zen route serves it, how big is its
# window - are answered by models.dev, the catalog opencode itself reads. Nothing
# is hardcoded in the proxy, so a newly launched free model needs no code change.
# Set to an empty value to skip a source.
ZEN_PROXY_MODELS_DEV_URL=https://models.dev/api.json

# Same file, committed to opencode's repository and refreshed daily. Used only when
# the source above cannot be reached.
ZEN_PROXY_MODELS_DEV_MIRROR_URL=https://raw.githubusercontent.com/anomalyco/opencode/v2/packages/core/src/models-dev/snapshot.txt

# Replay the official OpenCode client's headers upstream (x-opencode-client /
# -session / -request and its `opencode/<version>` user agent). Zen says its free
# tier is "only for use from within OpenCode"; replaying them does not by itself
# unlock anonymous traffic (ZEN_API_KEY does), it just keeps the fingerprint
# identical to the app. Set to 0 to send `zen-free-proxy/0.1` instead.
ZEN_PROXY_ZEN_CLIENT_HEADERS=1

# Comma separated keys the proxy will accept from clients. Empty = accept anything.
ZEN_PROXY_ALLOWED_CLIENT_KEYS=

ZEN_PROXY_LOG_LEVEL=INFO